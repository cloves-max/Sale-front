{
  "buildCommand": "npm run build -- --configuration=production",
  "outputDirectory": "dist/sales-front/browser",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://185.80.129.224:8080/api/:path*"
    },
    {
      "source": "/actuator/:path*",
      "destination": "http://185.80.129.224:8080/actuator/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
